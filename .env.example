# Telegram Clipper Environment Configuration

# Telegram Bot API Token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Runtime environment (development | production)
NODE_ENV=development

# Admin Telegram user ID for plan management (/pro, /unpro)
ADMIN_TELEGRAM_USER_ID=

# Manual PRO Upgrade Contact Configuration
# Telegram @username of the owner/admin for manual payment contact (without @)
OWNER_TELEGRAM_USERNAME=
# Optional pricing display (e.g. "₹299 / month" or "$4.99 / month"). Omit or leave empty if unpriced.
PRO_PRICE_DISPLAY=
# Optional custom payment/contact instructions
PRO_CONTACT_TEXT=

# PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_clipper

# YouTube Authentication & Anti-Bot Strategy
# Mode: auto | cookies_file | browser | none
# - auto: automatically detects cookies.txt in project root, or uses configured file/browser
# - cookies_file: uses Netscape format cookies text file (RECOMMENDED for Windows/Docker)
# - browser: extracts cookies directly from local browser (where supported, e.g. Firefox/Chrome)
# - none: unauthenticated
YOUTUBE_AUTH_MODE=auto

# Path to Netscape format cookies file (e.g. cookies.txt or D:/telegram-clipper/cookies.txt)
# Export using browser extension like "Get cookies.txt locally"
YOUTUBE_COOKIES_FILE=cookies.txt

# Local browser for cookie extraction (chrome | firefox | edge | brave | opera | vivaldi)
# Note: On Windows, Chrome/Brave/Edge with App-Bound Encryption may lock cookies. Use cookies.txt instead.
# YOUTUBE_BROWSER=firefox
# YOUTUBE_BROWSER_PROFILE=default

# Optional base64 or raw Netscape cookie content for headless cloud deployments
# YOUTUBE_COOKIES_CONTENT=
